---
import '../styles/site.css';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const {
	title,
	description = 'AI strategy, governance, and private AI for regulated industries.',
	ogImage = 'https://ohana-tech.com/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{title} — Ohana Tech</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={canonicalURL} />

	<meta property="og:title" content={`${title} — Ohana Tech`} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={ogImage} />
	<meta property="og:url" content={canonicalURL} />
	<meta property="og:type" content="website" />
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={`${title} — Ohana Tech`} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImage} />

	<meta name="keywords" content="AI strategy, AI governance, private AI, regulated industries, AI compliance, medical device, ISO 13485, NIST AI RMF, EU AI Act, Structured Context Specification" />

	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
	<slot />
</body>
</html>
