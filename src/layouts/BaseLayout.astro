---
import '../styles/site.css';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const {
	title,
	description = 'AI solutions for healthcare and regulated industries — patient access, care coordination, AI governance, and open standards.',
	ogImage = 'https://ohana-tech.com/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{title} — Ohana Consulting</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={canonicalURL} />

	<meta property="og:title" content={`${title} — Ohana Consulting`} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={ogImage} />
	<meta property="og:url" content={canonicalURL} />
	<meta property="og:type" content="website" />
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={`${title} — Ohana Consulting`} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImage} />

	<meta name="keywords" content="healthcare AI consulting, AI governance, FHIR, SMART on FHIR, care coordination, patient engagement, 21st Century Cures, NCPDP, clinical decision support, AI compliance" />

	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
	<slot />
</body>
</html>
