---
const currentPath = Astro.url.pathname;

function isActive(path: string) {
	if (path === '/') return currentPath === '/';
	return currentPath.startsWith(path);
}
---

<nav class="site-nav">
	<div class="nav-inner">
		<a href="/" class="nav-logo" aria-label="Ohana Consulting home">
			<img src="/logo.png" alt="Ohana Consulting" />
		</a>
		<ul class="nav-links">
			<li><a href="/services" class:list={['nav-link', { active: isActive('/services') }]}>Services</a></li>
			<li><a href="/about" class:list={['nav-link', { active: isActive('/about') }]}>About</a></li>
			<li><a href="/contact" class="nav-cta">Get in Touch</a></li>
		</ul>
	</div>
</nav>
