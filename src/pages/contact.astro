---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
	title="Contact"
	description="Get in touch with Ohana Tech about AI strategy, governance, and private AI for regulated businesses."
>
	<Nav />

	<div class="contact-page">
		<p class="section-label">Contact</p>
		<h1>Let's talk through the problem.</h1>
		<p class="lead">
			Most good engagements start with a specific question: where AI could help your business, how to govern
			the AI your people are already using, or whether your data can safely leave the building at all.
			Tell us what you're working on, and we'll tell you plainly whether there's a fit.
		</p>

		<div class="contact-methods">
			<div class="contact-method">
				<span class="contact-method-label">New engagements</span>
				<a href="mailto:sales@ohana-tech.com">sales@ohana-tech.com</a>
			</div>
			<div class="contact-method">
				<span class="contact-method-label">Client support</span>
				<a href="mailto:support@ohana-tech.com">support@ohana-tech.com</a>
			</div>
			<div class="contact-method">
				<span class="contact-method-label">General</span>
				<a href="mailto:info@ohana-tech.com">info@ohana-tech.com</a>
			</div>
		</div>
	</div>

	<SiteFooter />
</BaseLayout>
