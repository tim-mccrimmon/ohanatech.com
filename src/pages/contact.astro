---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
	title="Contact"
	description="Get in touch with Ohana Consulting — healthcare AI, governance, and interoperability."
>
	<Nav />

	<div class="contact-page">
		<p class="section-label">Contact</p>
		<h1>Let's talk through the problem.</h1>
		<p class="lead">
			Most good engagements start with a specific problem — a deployment that isn't going well, a governance
			question with no clear owner, an interoperability requirement that the vendor says can't be done.
			Bring the problem. We'll figure out whether there's a fit.
		</p>

		<div class="contact-methods">
			<div class="contact-method">
				<span class="contact-method-label">Email</span>
				<a href="mailto:info@ohana-tech.com">info@ohana-tech.com</a>
			</div>
		</div>

		<p class="contact-note">
			Ohana Consulting is a boutique practice. Engagements are taken selectively to ensure direct involvement
			on every project. Response time is typically within one business day.
		</p>
	</div>

	<SiteFooter />
</BaseLayout>
